generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Libro {
  id           Int          @id @default(autoincrement())
  titulo       String
  autor        String
  categoria    String
  anio         Int
  estado       String       @default("Disponible")
  prestamos    Prestamo[]
  devoluciones Devolucion[]
}

model Prestamo {
  id      Int      @id @default(autoincrement())
  fecha   DateTime @default(now())
  libroId Int
  libro   Libro    @relation(fields: [libroId], references: [id])
}

model Devolucion {
  id      Int      @id @default(autoincrement())
  fecha   DateTime @default(now())
  libroId Int
  libro   Libro    @relation(fields: [libroId], references: [id])
}
